#include "mbed.h"
#include "arm_book_lib.h"

const int passcode[4] = {0,1,2,3};

int main() {
    DigitalIn  b[6] = {D2,D3,D4,D5,D6,D7};
    DigitalOut alarm(LED1), error(LED3), block(LED2);

    for(int i=0;i<6;i++) b[i].mode(PullDown);

    int code[4], pos=0, fails=0;
    bool warn=false, lock=false;
    Timer t;
    Timer blinkTimer;  // separate timer just for blinking

    while(1) {
        if(fails >= 5) {
            block = 1;
            ThisThread::sleep_for(100ms);
            continue;
        }

        // LOCKDOWN — alarm stays ON, error blinks, lasts 1 minute
        if(lock) {
            alarm = 1;  // stays on continuously
            block = 0;

            // Blink error LED every 300ms using blinkTimer
            if(blinkTimer.elapsed_time() >= 300ms) {
                error = !error;
                blinkTimer.reset();
            }

            // End lockdown after 60 seconds
            if(t.elapsed_time() >= 60s) {
                lock  = false;
                error = 0;
                alarm = 0;
                t.stop();
                t.reset();
                blinkTimer.stop();
                blinkTimer.reset();
            }

            ThisThread::sleep_for(10ms);
            continue;
        }

        // WARNING — error blinks slowly for 30 seconds
        if(warn) {
            if(blinkTimer.elapsed_time() >= 500ms) {
                error = !error;
                blinkTimer.reset();
            }

            if(t.elapsed_time() >= 30s) {
                warn  = false;
                error = 0;
                t.stop();
                t.reset();
                blinkTimer.stop();
                blinkTimer.reset();
            }

            ThisThread::sleep_for(10ms);
            continue;
        }

        bool pressed = false;
        for(int i=0; i<6; i++) {
            if(b[i]) {
                pressed = true;
                code[pos++] = i;
                while(b[i]) ThisThread::sleep_for(10ms);

                if(pos == 4) {
                    bool good = true;
                    for(int j=0; j<4; j++) if(code[j] != passcode[j]) good=false;

                    if(good) {
                        alarm = 1;
                        fails = 0;
                        error = 0;
                    } else {
                        fails++;
                        error = 1;

                        // 3rd wrong — start warning
                        if(fails == 3) {
                            warn = true;
                            t.reset(); t.start();
                            blinkTimer.reset(); blinkTimer.start();
                        }

                        // 4th wrong — start lockdown
                        if(fails == 4) {
                            lock  = true;
                            error = 0;
                            t.reset(); t.start();
                            blinkTimer.reset(); blinkTimer.start();
                        }
                    }
                    pos = 0;
                }
                break;
            }
        }

        if(!pressed) ThisThread::sleep_for(20ms);
    }
}
