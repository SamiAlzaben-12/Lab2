#include "mbed.h"
#include "arm_book_lib.h"

const int passcode[4] = {0, 1, 2, 3};

int main() {
    DigitalIn buttons[6] = {D2, D3, D4, D5, D6, D7};
    DigitalOut alarmLed(LED1);
    DigitalOut incorrectCodeLed(LED3);
    DigitalOut systemBlockedLed(LED2);

    for(int i = 0; i < 6; i++) buttons[i].mode(PullDown);

    int enteredCode[4];
    int currentDigit = 0;
    int attempts = 0;
    bool alarmState = OFF;

    bool warning = false;
    Timer t;

    while (true) {
        if (attempts >= 5) {
            systemBlockedLed = ON;
            ThisThread::sleep_for(100ms);
            continue;
        }

        if (warning) {
            incorrectCodeLed = (t.read_ms() / 500) % 2;
            if (t.read_ms() >= 30000) {
                warning = false;
                incorrectCodeLed = OFF;
                t.stop();
                t.reset();
            }
            ThisThread::sleep_for(100ms);
            continue;
        }

        for (int i = 0; i < 6; i++) {
            if (buttons[i]) {
                enteredCode[currentDigit] = i;
                currentDigit++;

                while (buttons[i]) ThisThread::sleep_for(10ms);

                if (currentDigit == 4) {
                    bool ok = true;
                    for (int j = 0; j < 4; j++) {
                        if (enteredCode[j] != passcode[j]) ok = false;
                    }

                    if (ok) {
                        alarmState = ON;
                        attempts = 0;
                        incorrectCodeLed = OFF;
                    } else {
                        attempts++;
                        incorrectCodeLed = ON;
                        if (attempts >= 3) {
                            warning = true;
                            t.reset();
                            t.start();
                        }
                    }
                    currentDigit = 0;
                }
                break;
            }
        }

        alarmLed = alarmState;
        ThisThread::sleep_for(20ms);
    }
}
