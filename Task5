#include "mbed.h"
#include "arm_book_lib.h"

const int passcode[4]  = {0, 1, 2, 3};
const int adminCode[4] = {1, 1, 1, 1};

int main()
{
    DigitalIn buttons[6] = {D2, D3, D4, D5, D6, D7};

    DigitalOut alarmLed(LED1);
    DigitalOut incorrectCodeLed(LED3);
    DigitalOut systemBlockedLed(LED2);

    for(int i = 0; i < 6; i++) buttons[i].mode(PullDown);

    int  enteredCode[4];
    int  currentDigit    = 0;
    int  attempts        = 0;
    bool alarmState      = OFF;
    bool inWarningMode   = false;
    bool inLockdownMode  = false;
    int  lockdownCounter = 0;

    Timer warningTimer;
    Timer blinkTimer;

    while (true) {

        // LOCKDOWN MODE
        if (inLockdownMode) {
            systemBlockedLed = ON;
            alarmLed         = ON;

            // incorrectCodeLed blinks every 300ms
            if (blinkTimer.elapsed_time() >= 300ms) {
                incorrectCodeLed = !incorrectCodeLed;
                blinkTimer.reset();
            }

            // Read admin code during lockdown
            for (int i = 0; i < 6; i++) {
                if (buttons[i]) {
                    enteredCode[currentDigit] = i;
                    currentDigit++;
                    while(buttons[i]) ThisThread::sleep_for(10ms);

                    if (currentDigit == 4) {
                        bool isAdmin = true;
                        for(int j = 0; j < 4; j++) {
                            if(enteredCode[j] != adminCode[j]) {
                                isAdmin = false;
                                break;
                            }
                        }
                        if (isAdmin) {
                            inLockdownMode   = false;
                            incorrectCodeLed = OFF;
                            systemBlockedLed = OFF;
                            alarmLed         = OFF;
                            alarmState       = OFF;
                            attempts         = 0;  // reset on admin override
                            currentDigit     = 0;
                            warningTimer.stop();
                            warningTimer.reset();
                            blinkTimer.stop();
                            blinkTimer.reset();
                        } else {
                            currentDigit = 0;
                        }
                    }
                    break;
                }
            }

            // Lockdown ends after 60 seconds
            if (warningTimer.elapsed_time() >= 60s) {
                inLockdownMode   = false;
                incorrectCodeLed = OFF;
                systemBlockedLed = OFF;
                alarmLed         = OFF;
                alarmState       = OFF;
                attempts         = 0; //reset attempts so system works normally again
                currentDigit     = 0; //reset digit buffer too
                warningTimer.stop();
                warningTimer.reset();
                blinkTimer.stop();
                blinkTimer.reset();
            }

            ThisThread::sleep_for(10ms);
            continue;
        }

        // WARNING MODE
        if (inWarningMode) {
            if (blinkTimer.elapsed_time() >= 500ms) {
                incorrectCodeLed = !incorrectCodeLed;
                blinkTimer.reset();
            }
            if (warningTimer.elapsed_time() >= 30s) {
                inWarningMode    = false;
                incorrectCodeLed = OFF;
                warningTimer.stop();
                warningTimer.reset();
                blinkTimer.stop();
                blinkTimer.reset();
            }
            ThisThread::sleep_for(10ms);
            continue;
        }

        // EVENT COUNTER — binary display on LED1 and LED3 when idle
        if (!alarmState && !inWarningMode && !inLockdownMode) {
            alarmLed         = (lockdownCounter & 1) ? ON : OFF;
            incorrectCodeLed = (lockdownCounter & 2) ? ON : OFF;
        }

        // NORMAL CODE ENTRY
        for (int i = 0; i < 6; i++) {
            if (buttons[i]) {
                enteredCode[currentDigit] = i;
                currentDigit++;
                while(buttons[i]) ThisThread::sleep_for(10ms);

                if (currentDigit == 4) {
                    bool match = true;
                    for(int j = 0; j < 4; j++) {
                        if(enteredCode[j] != passcode[j]) match = false;
                    }

                    if (match) {
                        alarmState       = ON;
                        attempts         = 0;
                        incorrectCodeLed = OFF;
                    } else {
                        attempts++;
                        incorrectCodeLed = ON;

                        if (attempts == 3) {
                            inWarningMode = true;
                            warningTimer.reset();
                            warningTimer.start();
                            blinkTimer.reset();
                            blinkTimer.start();
                        }
                        if (attempts == 4) {
                            inLockdownMode = true;
                            lockdownCounter++;
                            warningTimer.reset();
                            warningTimer.start();
                            blinkTimer.reset();
                            blinkTimer.start();
                        }
                    }
                    currentDigit = 0;
                }
                break;
            }
        }

        alarmLed = alarmState;
        ThisThread::sleep_for(20ms);
    }
}
