#include "mbed.h"
#include "arm_book_lib.h"

// Define the correct passcode sequence
const int passcode[4] = {0, 1, 2, 3}; 
const int adminCode[4] = { 1, 1, 1, 1};   // ← NEW: admin code

int main()
{
    // Define the 6 tactile switches (pins may vary based on your board)
    DigitalIn buttons[6] = { D2, D3, D4, D5, D6, D7 };

    // Outputs
    DigitalOut alarmLed(LED1);
    DigitalOut incorrectCodeLed(LED3);
    DigitalOut systemBlockedLed(LED2);

    // Initialization
    for(int i=0; i<6; i++) buttons[i].mode(PullDown);
    
    int enteredCode[4];
    int currentDigit = 0;
    int attempts = 0;
    bool alarmState = OFF; 

    bool inWarningMode = false;
    bool inLockdownMode = false;
    Timer warningTimer;

    while (true) {
        if (attempts >= 5) {
            systemBlockedLed = ON;
            continue; // Lock the system
        }

        // Handle lockdown mode (60 seconds) ───────────────────────────────────────
        if (inLockdownMode) {
            systemBlockedLed = ON;
            int ms = warningTimer.elapsed_time().count() / 1000;
            incorrectCodeLed = (ms % 1000 < 300) ? ON : OFF;

            // During lockdown: allow admin code entry to exit lockdown
            for (int i = 0; i < 6; i++) {
                if (buttons[i]) {
                    enteredCode[currentDigit] = i;
                    currentDigit++;
                    
                    while(buttons[i]) { ThisThread::sleep_for(10ms); }

                    if (currentDigit == 4) {
                        bool isAdmin = true;
                        for(int j=0; j<4; j++) {
                            if(enteredCode[j] != adminCode[j]) {
                                isAdmin = false;
                                break;
                            }
                        }

                        if (isAdmin) {
                            inLockdownMode = false;
                            incorrectCodeLed = OFF;
                            systemBlockedLed = OFF;
                            warningTimer.stop();
                            warningTimer.reset();
                            attempts = 0;           // optional: also reset normal attempts
                            currentDigit = 0;
                            // Optional: short success feedback
                            alarmLed = ON;  ThisThread::sleep_for(200ms);  alarmLed = alarmState;
                        } else {
                            // Wrong admin code during lockdown → do nothing (or count as failed attempt if you want)
                            currentDigit = 0;
                        }
                    }
                    break;  // only one button at a time
                }
            }

            if (ms >= 60000) {
                inLockdownMode = false;
                incorrectCodeLed = OFF;
                systemBlockedLed = OFF;
                warningTimer.stop();
                warningTimer.reset();
            }
            ThisThread::sleep_for(100ms);
            continue;
        }

        // Handle warning mode (30 seconds slow blink)
        if (inWarningMode) {
            int ms = warningTimer.elapsed_time().count() / 1000;
            incorrectCodeLed = (ms / 500) % 2;
            if (ms >= 30000) {
                inWarningMode = false;
                incorrectCodeLed = OFF;
                warningTimer.stop();
                warningTimer.reset();
            }
            ThisThread::sleep_for(100ms);
            continue;
        }

        // Normal mode - regular code entry
        for (int i = 0; i < 6; i++) {
            if (buttons[i]) {
                enteredCode[currentDigit] = i;
                currentDigit++;
                
                while(buttons[i]) { ThisThread::sleep_for(10ms); } 

                if (currentDigit == 4) {
                    bool match = true;
                    for(int j=0; j<4; j++) {
                        if(enteredCode[j] != passcode[j]) match = false;
                    }

                    if (match) {
                        alarmState = ON;
                        attempts = 0;
                        incorrectCodeLed = OFF;
                    } else {
                        attempts++;
                        incorrectCodeLed = ON;

                        if (attempts == 3) {
                            inWarningMode = true;
                            warningTimer.reset();
                            warningTimer.start();
                        }
                        else if (attempts == 4) {
                            inLockdownMode = true;
                            warningTimer.reset();
                            warningTimer.start();
                        }
                    }
                    currentDigit = 0;
                }

                break;
            }
        }
        
        alarmLed = alarmState;
        ThisThread::sleep_for(20ms);
    }
}
